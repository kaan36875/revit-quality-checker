<Window x:Class="RevitQualityChecker.RevitAdapter.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quality Check Results"
        Width="820" Height="680"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#007ACC" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Quality Check Results" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Foreground="#B0D4F1" FontSize="12" Margin="0,4,0,0">
                    <Run Text="{Binding ModelName, Mode=OneTime}"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding Timestamp, Mode=OneTime}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Score + Stats -->
        <Border Grid.Row="1" Background="#252526" Padding="20,16" Margin="0,0,0,2">
            <WrapPanel>
                <!-- Score -->
                <StackPanel Margin="0,0,30,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScoreText, Mode=OneTime}" FontSize="42" FontWeight="Bold"
                               Foreground="{Binding ScoreBrush, Mode=OneTime}" HorizontalAlignment="Center"/>
                    <TextBlock Text="/ 100" Foreground="#888" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Stat Tiles -->
                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalChecked, Mode=OneTime}" FontSize="22" FontWeight="SemiBold" Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                        <TextBlock Text="CHECKED" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ErrorCount, Mode=OneTime}" FontSize="22" FontWeight="SemiBold" Foreground="#F44336" HorizontalAlignment="Center"/>
                        <TextBlock Text="ERRORS" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WarningCount, Mode=OneTime}" FontSize="22" FontWeight="SemiBold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                        <TextBlock Text="WARNINGS" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PassedCount, Mode=OneTime}" FontSize="22" FontWeight="SemiBold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                        <TextBlock Text="PASSED" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Rule Results List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <ItemsControl ItemsSource="{Binding RuleResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <!-- Rule Header (clickable to expand) -->
                                <ToggleButton IsChecked="{Binding IsExpanded}"
                                              Background="Transparent" BorderThickness="0"
                                              HorizontalContentAlignment="Stretch" Cursor="Hand"
                                              Padding="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="16"
                                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Rule Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RuleName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#E0E0E0"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#888"/>
                                        </StackPanel>

                                        <!-- Severity Badge -->
                                        <Border Grid.Column="2" Background="{Binding SeverityBackground}"
                                                CornerRadius="3" Padding="8,2" Margin="8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplaySeverity}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityBrush}"/>
                                        </Border>

                                        <!-- Auto-Fix Button -->
                                        <Button Grid.Column="3" Content="Fix" Command="{Binding AutoFixCommand}"
                                                Visibility="{Binding CanAutoFix, Converter={StaticResource BoolToVis}}"
                                                Background="#2E7D32" Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                Padding="10,3" Margin="4,0" Cursor="Hand" BorderThickness="0"
                                                VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Expand Arrow -->
                                        <TextBlock Grid.Column="4" FontSize="12" Foreground="#666"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasViolations, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▶"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▼"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ToggleButton>

                                <!-- Violations DataGrid (expandable) -->
                                <DataGrid ItemsSource="{Binding Violations}" AutoGenerateColumns="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          Background="#1E1E1E" RowBackground="#1E1E1E"
                                          AlternatingRowBackground="#262626"
                                          BorderThickness="0" GridLinesVisibility="None"
                                          Foreground="#CCC" FontSize="11"
                                          Margin="26,8,0,4" MaxHeight="220"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <EventSetter Event="MouseDoubleClick" Handler="ViolationRow_DoubleClick"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#333"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#333"/>
                                            <Setter Property="Foreground" Value="#AAA"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#444"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="6,3"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="80"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding ElementName}" Width="140"/>
                                        <DataGridTextColumn Header="Issue" Binding="{Binding Message}" Width="*"/>
                                        <DataGridTextColumn Header="Fix" Binding="{Binding SuggestedFix}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#252526" Padding="16,10">
            <DockPanel>
                <TextBlock Text="RevitQualityChecker" Foreground="#666" FontSize="11"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Export BCF" Command="{Binding ExportBcfCommand}"
                            Padding="16,6" FontSize="12"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Export HTML" Command="{Binding ExportHtmlCommand}"
                            Padding="16,6" FontSize="12"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A8AD4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Close" Click="CloseButton_Click"
                            Padding="16,6" FontSize="12" Margin="8,0,0,0"
                            Background="#3E3E3E" Foreground="#CCC" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#505050"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
