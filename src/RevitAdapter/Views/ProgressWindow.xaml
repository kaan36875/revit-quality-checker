<Window x:Class="RevitQualityChecker.RevitAdapter.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quality Checker"
        Width="380" Height="140"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#252526" CornerRadius="8" Padding="24,18"
            BorderBrush="#007ACC" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="StatusText" Text="Collecting elements..."
                       FontSize="13" Foreground="#E0E0E0" FontFamily="Segoe UI"
                       Margin="0,0,0,12"/>
            <ProgressBar x:Name="ProgressBar" Height="6" IsIndeterminate="True"
                         Background="#333" Foreground="#007ACC" BorderThickness="0"/>
            <TextBlock x:Name="DetailText" Text="" FontSize="11" Foreground="#888"
                       FontFamily="Segoe UI" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
