<Window x:Class="RevitQualityChecker.RevitAdapter.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Quality Checker"
        Width="420" Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI">

    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="Revit Quality Checker" FontSize="20" FontWeight="Bold"
                       Foreground="#007ACC" HorizontalAlignment="Center"/>
            <TextBlock Text="v1.0.0" FontSize="13" Foreground="#888"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Row="1" Height="1" Background="#333" Margin="0,16"/>

        <!-- Info -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#CCC" LineHeight="20">
                BIM model quality checker with configurable rules, auto-fix,
                HTML/BCF reporting, and multi-version Revit support.
            </TextBlock>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:" Foreground="#888" FontSize="11" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Kaan Beyazkilic" FontSize="11" Foreground="#E0E0E0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="License:" Foreground="#888" FontSize="11" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT" FontSize="11" Foreground="#E0E0E0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Revit:" Foreground="#888" FontSize="11" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="2022 — 2028" FontSize="11" Foreground="#E0E0E0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Website:" Foreground="#888" FontSize="11" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11">
                    <Hyperlink NavigateUri="https://kaanbeyazkilic.com" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="#007ACC">
                        <Run Text="kaanbeyazkilic.com"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- Close -->
        <Button Grid.Row="3" Content="Close" Click="CloseButton_Click"
                HorizontalAlignment="Center" Padding="24,7" FontSize="12"
                Background="#3E3E3E" Foreground="#CCC" BorderThickness="0" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
